# Konfigurasi layanan API SmartDaycare. Semua opsional — nilai bawaan cocok untuk pengembangan lokal.
# Salin menjadi api/.env (dev.sh / start.sh melakukannya otomatis). Komentar selalu di baris sendiri.

# production: dokumentasi API (/api/docs) dimatikan
SD_ENV=development

# Kosong = SQLite di api/data/smartdaycare.db. Contoh PostgreSQL: postgresql+psycopg://user:pass@host/db
SD_DATABASE_URL=

# Kosong = kunci acak per proses (sesi tetap valid karena token disimpan sebagai hash)
SD_SECRET_KEY=

SD_TIMEZONE=Asia/Jakarta
SD_SESSION_HOURS=12
SD_REMEMBER_DAYS=30

# Kosong = otomatis (HTTPS → Secure). Isi 1/0 untuk memaksa.
SD_COOKIE_SECURE=

# lax (bawaan) | strict | none. "none" hanya untuk pratinjau di dalam iframe
# (cookie otomatis menjadi Secure + Partitioned).
SD_COOKIE_SAMESITE=lax

# Origin tambahan yang boleh mengubah data, dipisah koma. Perlu hanya bila web dan API
# dilayani di domain berbeda, atau proxy mengganti Host dan peramban lama tanpa Sec-Fetch-Site.
SD_ALLOWED_ORIGINS=

# Pembatas laju & penguncian akun
SD_LOGIN_PER_MINUTE=10
SD_LOCKOUT_FAILS=5
SD_LOCKOUT_MINUTES=15
SD_WRITE_PER_MINUTE=120

# Foto piring: ukuran maksimum (byte) dan masa simpan (hari); catatan harian disimpan 400 hari
# (laporan semester membutuhkan 180 hari + periode pembanding)
SD_MAX_PHOTO_BYTES=163840
SD_PHOTO_KEEP_DAYS=3
SD_LOG_KEEP_DAYS=400

# Jeda pembacaan udara (detik)
SD_AIR_INTERVAL=5

# ---------------------------------------------------------------------------------
# Mode data. 1 (bawaan) = data contoh (anak, akun, kode undangan) diisi otomatis agar
# aplikasi langsung bisa dicoba. 0 = produksi: mulai kosong dengan satu akun admin.
SD_SAMPLE_DATA=1
# Akun admin pertama (hanya dipakai saat SD_SAMPLE_DATA=0 dan belum ada pengguna).
# Bila kata sandi kosong, kata sandi sementara dibuat dan dicetak di log saat pertama jalan.
SD_ADMIN_EMAIL=
SD_ADMIN_NAME=Admin Daycare
SD_ADMIN_PASSWORD=

# Alamat situs (dipakai di tautan email/WhatsApp dan pemeriksaan alamat siaran kamera)
SD_PUBLIC_URL=

# Pengirim email: SMTP (mis. Gmail App Password, Zoho, Mailgun SMTP) ATAU Resend API.
SD_SMTP_HOST=
SD_SMTP_PORT=587
SD_SMTP_USER=
SD_SMTP_PASS=
# starttls (bawaan) | ssl | none
SD_SMTP_SECURITY=starttls
SD_RESEND_API_KEY=
SD_EMAIL_FROM=SmartDaycare <no-reply@contoh.id>

# Pengirim WhatsApp: meta (WhatsApp Cloud API) atau fonnte.
SD_WA_PROVIDER=
SD_WA_TOKEN=
# Hanya untuk meta: Phone Number ID dan (opsional) nama templat yang sudah disetujui.
SD_WA_PHONE_ID=
SD_WA_TEMPLATE=

# Cadangan basis data SQLite harian (pukul 02.00) dan masa simpan (hari)
SD_BACKUP_DIR=
SD_BACKUP_KEEP_DAYS=14

# Jembatan MQTT opsional untuk sensor, mis. mqtt://user:pass@broker:1883 (butuh paket paho-mqtt)
SD_MQTT_URL=
SD_MQTT_TOPIC=smartdaycare/sensors/+

# Ukuran maksimum foto kamera (byte)
SD_MAX_SNAPSHOT_BYTES=262144
