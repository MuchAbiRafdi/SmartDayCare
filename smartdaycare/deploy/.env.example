# Domain publik (sertifikat HTTPS dibuat otomatis oleh Caddy; port 80/443 harus terbuka)
DOMAIN=daycare.contoh.id

# Mulai kosong dengan satu akun admin (0) atau dengan data contoh (1)
SD_SAMPLE_DATA=0
SD_ADMIN_EMAIL=admin@contoh.id
SD_ADMIN_NAME=Kepala Daycare
SD_ADMIN_PASSWORD=

SD_PUBLIC_URL=https://daycare.contoh.id
SD_SECRET_KEY=ganti-dengan-string-acak-panjang
SD_TIMEZONE=Asia/Jakarta

# Email (pilih salah satu)
SD_SMTP_HOST=
SD_SMTP_PORT=587
SD_SMTP_USER=
SD_SMTP_PASS=
SD_RESEND_API_KEY=
SD_EMAIL_FROM=SmartDaycare <no-reply@contoh.id>

# WhatsApp (meta | fonnte)
SD_WA_PROVIDER=
SD_WA_TOKEN=
SD_WA_PHONE_ID=
SD_WA_TEMPLATE=

# Cadangan harian
SD_BACKUP_KEEP_DAYS=14

# MQTT opsional
SD_MQTT_URL=
